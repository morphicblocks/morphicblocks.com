# Site configuration — copy to `.env` and fill in your own values.
# All values are build-time PUBLIC_* vars (baked into the static output).
# On Cloudflare Pages, set these in the project's environment variables.
# These are placeholders; put the real values in `.env` (git-ignored).

PUBLIC_SITE_NAME="Example Project"
PUBLIC_SITE_TAGLINE="Your one-line tagline."
PUBLIC_SITE_DESCRIPTION="A short description of your project for meta tags and the hero."
PUBLIC_UNIVERSITY="Your Organization"
PUBLIC_UNIVERSITY_URL="https://example.org/"

# npm package (used in the install command and the "View on npm" link)
PUBLIC_NPM_PACKAGE="your-package"
PUBLIC_NPM_URL="https://www.npmjs.com/package/your-package"

# Links (switch these whenever the subdomains/repo change)
PUBLIC_DOCS_URL="https://docs.example.com"
PUBLIC_PLAYGROUND_URL="https://playground.example.com"
PUBLIC_GITHUB_URL="https://github.com/your-org/your-repo"
PUBLIC_IMPRINT_URL="/imprint"
PUBLIC_PRIVACY_URL="/privacy"
PUBLIC_DISCLAIMER_URL="/disclaimer"
