---
// The landing page body. Rendered by both `/` and `/de/`; all copy comes from
// src/i18n, so the two locales share one set of markup and styles.
import CodeTabs from "./CodeTabs.astro";
import Screenshots from "./Screenshots.astro";
import InstallCommand from "./InstallCommand.astro";
import { site, externalAttrs } from "../config";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Code samples stay in English, as usual for developer documentation. These
// mirror the docs quick start so the two cannot drift apart. main.ts leads,
// being the file a reader wants first; the tab strip follows this order.
const quickstartFiles = [
  {
    name: "main.ts",
    lang: "ts",
    code: `import { MorphicBlocks } from "${site.npmPackage}";
import definitions from "./definitions.json";
import { behaviors } from "./behaviors";

// The constructor takes the whole definitions file plus your behaviors.
const engine = new MorphicBlocks(definitions, behaviors);

engine.mount({
  workspaceContainer: document.getElementById("workspace")!,
  workspaceMode: "conceptual",
  toolboxMode: "conceptual",
});

engine.mountToolbox(document.getElementById("toolbox")!);

// Switch representation at runtime; the same blocks re-render.
engine.setModes({ workspaceMode: "python", toolboxMode: "python" });`,
  },
  {
    name: "definitions.json",
    lang: "json",
    code: `{
  "elementTypes": {
    "title":      "text",
    "conceptual": "code",
    "python":     "code"
  },
  "modes": [
    { "name": "conceptual", "elements": ["title", "conceptual"] },
    { "name": "python",     "elements": ["title", "python"] }
  ],
  "blocks": [
    {
      "identifier": "text_print",
      "elements": {
        "title":      "Print",
        "conceptual": "Output %1",
        "python":     "print(%1)"
      },
      "inputSlots": {
        "1": { "kind": "value", "name": "TEXT" }
      }
    }
  ]
}`,
  },
  {
    name: "behaviors.ts",
    lang: "ts",
    code: `import type { MorphicBehaviorMap } from "${site.npmPackage}";

// One function per block identifier, returning the executable JavaScript.
export const behaviors: MorphicBehaviorMap = {
  text_print(proxy) {
    return \`console.log(\${proxy.inputs.TEXT ?? "undefined"});\\n\`;
  },
};`,
  },
];

// Captures in public/modes/, paired by index with the localized labels in
// t.modes, so this order is what binds each image to its name.
const modeImages = [
  "/modes/iconic.png",
  "/modes/conceptual.png",
  "/modes/syntactic.png",
];
---

<!-- Hero -->
<section class="hero">
  <div class="container hero-inner">
    <p class="eyebrow">{t.heroEyebrow}</p>
    <h1>{t.heroHeadline}</h1>
    <p class="lede">{t.heroLede}</p>
    {
      (site.links.docs || site.links.playground || site.links.github) && (
        <div class="cta">
          {site.links.docs && (
            <a
              class="btn btn-primary"
              href={site.links.docs}
              {...externalAttrs(site.links.docs)}>
              {t.ctaDocs}
            </a>
          )}
          {site.links.playground && (
            <a
              class="btn btn-ghost"
              href={site.links.playground}
              {...externalAttrs(site.links.playground)}>
              {t.ctaPlayground}
            </a>
          )}
          {site.links.github && (
            <a
              class="btn btn-ghost"
              href={site.links.github}
              {...externalAttrs(site.links.github)}>
              {t.ctaGithub}
            </a>
          )}
        </div>
      )
    }
    <InstallCommand />
  </div>
</section>

<!-- Modes strip -->
<section class="container modes">
  <span class="modes-label">{t.modesLabel}</span>
  <div class="modes-grid">
    {
      t.modes.map((m, i) => (
        <div class="mode-card">
          <span class="mode-name">{m.name}</span>
          <img src={modeImages[i]} alt={m.alt} loading="lazy" />
        </div>
      ))
    }
  </div>
</section>

<!-- Features -->
<section class="container features">
  {
    t.features.map((f) => (
      <article class="feature">
        <h3>{f.title}</h3>
        <p>{f.body}</p>
      </article>
    ))
  }
</section>

<!-- Quick start -->
<section class="container quickstart">
  <div class="qs-head">
    <div>
      <h2>{t.quickstartTitle}</h2>
      <p>{t.quickstartBody}</p>
      {
        site.links.docs && (
          <a
            class="qs-docs"
            href={site.links.docs}
            {...externalAttrs(site.links.docs)}>
            {t.quickstartLink}
          </a>
        )
      }
    </div>
    <div class="qs-install">
      <InstallCommand />
    </div>
  </div>
  <div class="qs-code">
    <CodeTabs files={quickstartFiles} label={t.quickstartTitle} />
  </div>
</section>

<!-- Screenshots -->
<Screenshots />


<style>
  /* Hero */
  .hero {
    background: var(--hero-glow), var(--hero-bg);
    color: var(--hero-text);
    padding-block: clamp(3.5rem, 9vw, 6.5rem);
  }
  .eyebrow {
    color: var(--eyebrow);
    font-weight: 600;
    font-size: 0.86rem;
    letter-spacing: 0.02em;
    margin: 0 0 1rem;
  }
  .hero h1 {
    font-size: clamp(1.9rem, 4.6vw, 3rem);
    text-wrap: balance;
  }
  .lede {
    color: var(--hero-muted);
    font-size: clamp(1.02rem, 2.2vw, 1.22rem);
    max-width: 58ch;
    margin: 1.25rem 0 2rem;
  }
  .cta {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  /* Modes strip */
  .modes {
    margin-top: 2.6rem;
    position: relative;
    z-index: 2;
  }
  .modes-label {
    display: block;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.9rem;
  }
  .modes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .mode-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  /* The three captures are the same width but not the same height (263, 287
     and 144px), which left the cards ragged. A shared box built from the
     tallest of them, with the capture fitted inside, lines them up without
     cropping anything. The fill is the captures' own edge colour, so the
     letterboxing on the shorter ones does not read as a gap. */
  .mode-card img {
    width: 100%;
    aspect-ratio: 592 / 287;
    object-fit: contain;
    background: #e5e5e5;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }
  .mode-name {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--eyebrow);
    font-weight: 700;
  }

  /* Features */
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 4rem;
  }
  .feature h3 {
    font-size: 1.2rem;
    margin-bottom: 0.55rem;
  }
  .feature p {
    color: var(--text-muted);
    margin: 0;
  }

  /* Quick start */
  .quickstart {
    margin-top: 4.5rem;
  }
  .qs-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.2rem;
  }
  .qs-head h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
  }
  .qs-head p {
    color: var(--text-muted);
    max-width: 46ch;
    margin: 0.5rem 0 0.7rem;
  }
  .qs-docs {
    font-weight: 600;
  }
  .qs-install :global(.install) {
    margin-top: 0;
  }
  .qs-code :global(pre) {
    margin: 0;
    padding: 1.2rem 1.3rem;
    overflow: auto;
    height: 100%;
    font-size: 0.9rem;
    line-height: 1.6;
  }


  @media (max-width: 780px) {
    .modes-grid,
    .features {
      grid-template-columns: 1fr;
    }
  }
</style>
