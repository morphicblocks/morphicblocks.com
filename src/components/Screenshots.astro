---
// Screenshot slider — CSS scroll-snap, no JS. Images are placeholders in
// public/screenshots/; replace the files to swap in real captures. The per-image
// data (paths, alt text, captions per language) lives in
// src/data/screenshots.json.
import shots from "../data/screenshots.json";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="container shots" aria-label={t.screenshotsAria}>
  <h2>{t.screenshotsTitle}</h2>
  <p class="hint">{t.screenshotsHint}</p>
  <div class="slider" tabindex="0">
    {
      shots.map((s) => (
        <figure class="slide">
          <img src={s.src} alt={s.alt[lang]} loading="lazy" />
          <figcaption>{s.caption[lang]}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .shots {
    margin-top: 4.5rem;
  }
  h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
  }
  .hint {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin: 0.4rem 0 1.2rem;
  }
  .slider {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(100%, 860px);
    gap: 1.1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.6rem;
    scrollbar-width: thin;
  }
  .slide {
    margin: 0;
    scroll-snap-align: center;
  }
  .slide img {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  figcaption {
    margin-top: 0.55rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.88rem;
  }
</style>
