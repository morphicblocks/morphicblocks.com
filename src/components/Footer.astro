---
// Footer. URLs come from src/config.ts (env-driven), labels from src/i18n.
import { site, externalAttrs } from "../config";
import { getLangFromUrl, useTranslations, homePath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
// Links whose PUBLIC_* var is unset are dropped, and a column that ends up
// empty is not rendered at all.
const cols = [
  {
    title: t.footerProject,
    links: [
      { label: t.footerDocs, href: site.links.docs },
      { label: t.footerPlayground, href: site.links.playground },
      { label: t.footerGithub, href: site.links.github },
      { label: t.footerNpm, href: site.links.npm },
    ],
  },
  {
    title: t.footerLegal,
    links: [
      { label: t.footerImprint, href: site.legal.imprint[lang] },
      { label: t.footerPrivacy, href: site.legal.privacy[lang] },
      { label: t.footerDisclaimer, href: site.legal.disclaimer[lang] },
    ],
  },
]
  .map((c) => ({ ...c, links: c.links.filter((l) => l.href) }))
  .filter((c) => c.links.length > 0);
---

<footer class="site-footer">
  <div class="container inner">
    <div class="col brand-col">
      <a
        class="brand"
        href={homePath(lang)}
        aria-label={`${site.name} ${t.homeSuffix}`}>
        <img src="/logo.svg" alt="" width="26" height="26" />
        <span>{site.name}</span>
      </a>
      <p class="tag">{t.tagline}</p>
    </div>
    {
      cols.map((c) => (
        <nav class="col" aria-label={c.title}>
          <h3>{c.title}</h3>
          <ul>
            {c.links.map((l) => (
              <li>
                <a href={l.href} {...externalAttrs(l.href)}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="container bottom">
    <span>&copy; {year} {site.name}</span>
    {
      site.university[lang] &&
        (site.links.university ? (
          <a
            class="dev"
            href={site.links.university}
            {...externalAttrs(site.links.university)}>
            {t.developedAt} {site.university[lang]}
          </a>
        ) : (
          <span class="dev">
            {t.developedAt} {site.university[lang]}
          </span>
        ))
    }
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
    padding-top: 3rem;
    margin-top: 4rem;
  }
  .inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 700;
    color: var(--text);
  }
  .tag {
    color: var(--text-muted);
    margin: 0.6rem 0 0;
    font-size: 0.92rem;
  }
  .col h3 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 0.8rem;
  }
  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .col a {
    color: var(--text);
    font-size: 0.95rem;
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
    margin-top: 2.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.88rem;
  }
  .bottom .dev {
    color: var(--text-muted);
  }
  .bottom .dev:hover {
    color: var(--text);
  }
  @media (max-width: 720px) {
    .inner {
      grid-template-columns: 1fr 1fr;
    }
    .brand-col {
      grid-column: 1 / -1;
    }
  }
</style>
