---
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import Screenshots from "../components/Screenshots.astro";
import InstallCommand from "../components/InstallCommand.astro";
import { site } from "../config";

const quickstart = `import { MorphicBlocks } from "${site.npmPackage}";
import definitions from "./definitions.json";
import { behaviors } from "./behaviors";

// definitions declare your blocks, elements, and modes
const engine = new MorphicBlocks(
  definitions.blocks,
  behaviors,
  definitions.elementTypes,
);

engine.mount({
  workspaceContainer: document.getElementById("app"),
  modes: definitions.modes,
});

// switch representation at runtime — blocks re-render
engine.setModes({ workspaceMode: "syntactic" });`;

const features = [
  {
    title: "One block, many modes",
    body: "A single morphic block carries several visual elements — icons, natural-language labels, and code templates. Modes decide which are shown, and switch at runtime without remounting.",
  },
  {
    title: "Declarative & config-driven",
    body: "Define blocks in JSON, behaviors in TypeScript, and one CSS file per mode. Extend or restyle an environment by editing config, not Blockly's multi-file imperative setup.",
  },
  {
    title: "Built for transition",
    body: "Render the same program as icons, blocks, or text to scaffold the gradual path from block-based to text-based programming — one framework, many learning stages.",
  },
];

// Same statement across modes. Images are placeholders in public/modes/.
const modes = [
  {
    name: "Iconic",
    img: "/modes/iconic.svg",
    sample: "🖨  ( … )",
  },
  {
    name: "Lexical",
    img: "/modes/lexical.svg",
    sample: "print ( message )",
  },
  {
    name: "Syntactic",
    img: "/modes/syntactic.svg",
    sample: "console.log(message);",
  },
];
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Open-source · TypeScript · built on Google Blockly</p>
      <h1>Render the same program<br />in many modes.</h1>
      <p class="lede">
        Morphic Blocks is an embeddable TypeScript library built on top of
        Google Blockly. It renders one block model in multiple
        developer-defined modes — iconic, lexical, syntactic, or any
        representation you design — to support the gradual transition between
        block-based and text-based programming.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href={site.links.docs}>Read the docs</a>
        <a class="btn btn-ghost" href={site.links.playground}
          >Try the playground</a
        >
      </div>
      <InstallCommand />
    </div>
  </section>

  <!-- Modes strip -->
  <section class="container modes">
    <span class="modes-label">Same statement, three modes</span>
    <div class="modes-grid">
      {
        modes.map((m) => (
          <div class="mode-card">
            <span class="mode-name">{m.name}</span>
            <img src={m.img} alt={`${m.name} mode placeholder`} loading="lazy" />
            <code class="mode-sample">{m.sample}</code>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Features -->
  <section class="container features">
    {
      features.map((f) => (
        <article class="feature">
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </article>
      ))
    }
  </section>

  <!-- Quick start -->
  <section class="container quickstart">
    <div class="qs-head">
      <div>
        <h2>Quick start</h2>
        <p>
          Install the package, hand it your definitions and behaviors, and
          mount. That's the whole loop — the docs cover modes, toolbox,
          codespace, and behaviors in depth.
        </p>
        <a class="qs-docs" href={site.links.docs}>Read the full guide →</a>
      </div>
      <div class="qs-install">
        <InstallCommand />
      </div>
    </div>
    <div class="qs-code">
      <Code code={quickstart} lang="ts" theme="github-dark" />
    </div>
  </section>

  <!-- Screenshots -->
  <Screenshots />

  <!-- Closing CTA -->
  <section class="container closing">
    <div class="closing-card">
      <h2>Build your own multi-modal environment</h2>
      <p>
        Embed Morphic Blocks as a library, define your modes, and ship a
        workspace that meets learners where they are.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href={site.links.github}>View on GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    background: var(--hero-glow), var(--hero-bg);
    color: var(--hero-text);
    padding-block: clamp(3.5rem, 9vw, 6.5rem);
  }
  .eyebrow {
    color: var(--eyebrow);
    font-weight: 600;
    font-size: 0.86rem;
    letter-spacing: 0.02em;
    margin: 0 0 1rem;
  }
  .hero h1 {
    font-size: clamp(2.3rem, 6vw, 3.75rem);
    max-width: 15ch;
  }
  .lede {
    color: var(--hero-muted);
    font-size: clamp(1.02rem, 2.2vw, 1.22rem);
    max-width: 58ch;
    margin: 1.25rem 0 2rem;
  }
  .cta {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  /* Modes strip */
  .modes {
    margin-top: 2.6rem;
    position: relative;
    z-index: 2;
  }
  .modes-label {
    display: block;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.9rem;
  }
  .modes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .mode-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .mode-card img {
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }
  .mode-name {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--eyebrow);
    font-weight: 700;
  }
  .mode-sample {
    font-family: var(--font-mono);
    font-size: 0.98rem;
    color: var(--text);
  }

  /* Features */
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 4rem;
  }
  .feature h3 {
    font-size: 1.2rem;
    margin-bottom: 0.55rem;
  }
  .feature p {
    color: var(--text-muted);
    margin: 0;
  }

  /* Quick start */
  .quickstart {
    margin-top: 4.5rem;
  }
  .qs-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.2rem;
  }
  .qs-head h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
  }
  .qs-head p {
    color: var(--text-muted);
    max-width: 46ch;
    margin: 0.5rem 0 0.7rem;
  }
  .qs-docs {
    font-weight: 600;
  }
  .qs-install :global(.install) {
    margin-top: 0;
  }
  .qs-code :global(pre) {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.2rem 1.3rem;
    overflow-x: auto;
    box-shadow: var(--shadow);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* Closing */
  .closing {
    margin-top: 4.5rem;
  }
  .closing-card {
    background: var(--accent-gradient);
    color: #fff;
    border-radius: calc(var(--radius) + 4px);
    padding: clamp(2rem, 5vw, 3.2rem);
    text-align: center;
  }
  .closing-card h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.1rem);
  }
  .closing-card p {
    max-width: 52ch;
    margin: 0.8rem auto 1.6rem;
    color: rgba(255, 255, 255, 0.92);
  }
  .closing-card .btn-primary {
    background: #fff;
    color: var(--accent);
  }

  @media (max-width: 780px) {
    .modes-grid,
    .features {
      grid-template-columns: 1fr;
    }
  }
</style>
